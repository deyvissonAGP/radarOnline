APP_NAME="Radar de vagas tech"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Banco (o serviço "db" do docker-compose)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=radar
DB_USERNAME=radar
DB_PASSWORD=radar

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
# Fila no banco: os botões da página /rotinas são executados pelo serviço "worker"
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# ---- Radar de vagas ----
VAGAS_JANELA_HORAS=72
VAGAS_MANTER_DIAS=30
# Avisa no Telegram quando uma fonte falha ou volta vazia este número de coletas seguidas
VAGAS_ALERTA_FALHAS=2
# Áreas aceitas (vazio = todas): desenvolvimento,dados,infra,qa,seguranca,design,produto,gestao,suporte,outras
VAGAS_AREAS=
VAGAS_FUSO=America/Sao_Paulo

# Fontes (true/false)
FONTE_GUPY=true
FONTE_GITHUB=true
FONTE_HIMALAYAS=true
FONTE_REMOTAR=true
FONTE_PROGRAMATHOR=true
# Desligado: os termos do LinkedIn proíbem coleta automatizada. Leia o README antes.
FONTE_LINKEDIN=false

# Repositórios de vagas no GitHub (separados por vírgula)
GITHUB_REPOSITORIOS=backend-br/vagas,frontendbr/vagas,react-brasil/vagas,soujava/vagas-java,qa-brasil/vagas,androiddevbr/vagas,CocoaHeadsBrasil/vagas,datascience-br/vagas,uxbrasil/vagas,vuejs-br/vagas,phpdevbr/vagas
# Opcional: token sem nenhuma permissão, só para subir o limite de requisições
GITHUB_TOKEN=

# Telegram: crie o bot com o @BotFather e pegue o chat_id (veja o README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_POR_RODADA=15
# Filtros pessoais (vazio = todas): remoto,hibrido,presencial / estagio,junior,pleno,senior,especialista
TELEGRAM_MODELOS=
TELEGRAM_NIVEIS=
# Só estas áreas / só vagas que citam uma destas tecnologias (ex.: php,laravel)
TELEGRAM_AREAS=
TELEGRAM_TECNOLOGIAS=
