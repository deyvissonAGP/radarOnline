# .env de PRODUÇÃO. No servidor: cp .env.producao.example .env e preencha o que está marcado com ⚠️.

APP_NAME="Radar de vagas tech"
APP_ENV=production
APP_DEBUG=false
# ⚠️ Gere com: docker run --rm radar-vagas:latest php artisan key:generate --show
APP_KEY=
# ⚠️ O subdomínio, com https
APP_URL=https://radar.confeitae.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Um arquivo de log por dia, guardando 14 dias
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# Porta local em que o site escuta (só 127.0.0.1). O proxy do servidor repassa o subdomínio para ela.
RADAR_PORTA=8090

# ⚠️ Usuário e senha do site. Use uma senha longa (ex.: openssl rand -base64 24).
RADAR_USUARIO=
RADAR_SENHA=
# /saude responde erro se a última coleta tiver mais horas que isso (agendador parado)
RADAR_SAUDE_HORAS=4

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=radar
DB_USERNAME=radar
# ⚠️ Senha forte (ex.: openssl rand -hex 24). Não mude depois de subir o banco pela primeira vez.
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# ---- Radar de vagas ----
VAGAS_JANELA_HORAS=72
VAGAS_MANTER_DIAS=30
VAGAS_FUSO=America/Sao_Paulo
VAGAS_ALERTA_FALHAS=2
# Áreas aceitas (vazio = todas): desenvolvimento,dados,infra,qa,seguranca,design,produto,gestao,suporte,outras
VAGAS_AREAS=

FONTE_GUPY=true
FONTE_GITHUB=true
FONTE_HIMALAYAS=true
FONTE_REMOTAR=true
FONTE_PROGRAMATHOR=true
FONTE_LINKEDIN=false

GITHUB_REPOSITORIOS=backend-br/vagas,frontendbr/vagas,react-brasil/vagas,soujava/vagas-java,qa-brasil/vagas,androiddevbr/vagas,CocoaHeadsBrasil/vagas,datascience-br/vagas,uxbrasil/vagas,vuejs-br/vagas,phpdevbr/vagas
GITHUB_TOKEN=

# Telegram (veja o README). Antes do primeiro envio: php artisan vagas:notificar --marcar-enviadas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_POR_RODADA=15
TELEGRAM_MODELOS=
TELEGRAM_NIVEIS=
TELEGRAM_AREAS=
TELEGRAM_TECNOLOGIAS=
